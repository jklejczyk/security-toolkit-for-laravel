{
    "name": "jklejczyk/security-toolkit-for-laravel",
    "description": "Security audit for Laravel 12 and 13 in one Artisan command: configuration, file storage, authentication and dependency checks with clear recommendations, CWE and CVSS.",
    "keywords": [
        "laravel",
        "security",
        "appsec",
        "audit",
        "vulnerability",
        "scanner",
        "cwe",
        "cvss"
    ],
    "homepage": "https://github.com/jklejczyk/security-toolkit-for-laravel",
    "license": "MIT",
    "support": {
        "issues": "https://github.com/jklejczyk/security-toolkit-for-laravel/issues",
        "source": "https://github.com/jklejczyk/security-toolkit-for-laravel",
        "security": "https://github.com/jklejczyk/security-toolkit-for-laravel/security/policy"
    },
    "authors": [
        {
            "name": "Jakub Klejczyk",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "composer-runtime-api": "^2.0",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/process": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "illuminate/validation": "^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/fortify": "^1.25",
        "laravel/pint": "^1.20",
        "laravel/sanctum": "^4.3",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Jklejczyk\\SecurityToolkit\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jklejczyk\\SecurityToolkit\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint",
        "lint": "vendor/bin/pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jklejczyk\\SecurityToolkit\\SecurityToolkitServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
